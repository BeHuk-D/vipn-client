if(NOT CLIENT_TARGET_NAME)
    set(CLIENT_TARGET_NAME "ViPN" CACHE STRING "Client executable target name")
endif()
if(NOT CLIENT_APPLICATION_NAME)
    set(CLIENT_APPLICATION_NAME "ViPN" CACHE STRING "Application display and executable name")
endif()
if(NOT CLIENT_SERVICE_NAME)
    set(CLIENT_SERVICE_NAME "ViPN-service" CACHE STRING "Service executable name")
endif()
if(NOT CLIENT_ORGANIZATION_NAME)
    set(CLIENT_ORGANIZATION_NAME "ViPN" CACHE STRING "QSettings organization name")
endif()
if(NOT CLIENT_APP_INSTANCE_NAME)
    set(CLIENT_APP_INSTANCE_NAME "ViPNInstance" CACHE STRING "Single-instance local server name")
endif()
if(NOT CLIENT_APP_DESCRIPTION)
    set(CLIENT_APP_DESCRIPTION "ViPN VPN client" CACHE STRING "Human readable application description")
endif()

# -- brand-owned external links (leave empty to hide the corresponding UI entry)
if(NOT DEFINED CLIENT_BRAND_WEBSITE_URL)
    set(CLIENT_BRAND_WEBSITE_URL "" CACHE STRING "Brand website URL")
endif()
if(NOT DEFINED CLIENT_BRAND_DOCS_URL)
    set(CLIENT_BRAND_DOCS_URL "" CACHE STRING "Brand documentation URL")
endif()
if(NOT DEFINED CLIENT_BRAND_HOST_URL)
    set(CLIENT_BRAND_HOST_URL "" CACHE STRING "Brand hosting service URL")
endif()
if(NOT DEFINED CLIENT_BRAND_SUPPORT_EMAIL)
    set(CLIENT_BRAND_SUPPORT_EMAIL "" CACHE STRING "Brand support email address")
endif()
if(NOT DEFINED CLIENT_BRAND_TELEGRAM_URL)
    set(CLIENT_BRAND_TELEGRAM_URL "" CACHE STRING "Brand Telegram community URL")
endif()
if(NOT DEFINED CLIENT_BRAND_GITHUB_URL)
    set(CLIENT_BRAND_GITHUB_URL "" CACHE STRING "Brand source repository URL")
endif()
if(NOT DEFINED CLIENT_BRAND_PRIVACY_URL)
    set(CLIENT_BRAND_PRIVACY_URL "" CACHE STRING "Brand privacy policy URL")
endif()
if(NOT CLIENT_KEYCHAIN_NAME)
    set(CLIENT_KEYCHAIN_NAME "${CLIENT_APPLICATION_NAME}-Keychain" CACHE STRING "QtKeychain service name used for encrypted settings keys")
endif()

# -- QML entry points and UI resources
if(NOT CLIENT_QML_ENTRYPOINT)
    set(CLIENT_QML_ENTRYPOINT "qrc:/ui/qml/main2.qml" CACHE STRING "Main QML entrypoint URL")
endif()
if(NOT CLIENT_QML_IMPORT_PATH)
    set(CLIENT_QML_IMPORT_PATH "qrc:/ui/qml/Modules/" CACHE STRING "Additional QQmlEngine import path")
endif()
if(NOT CLIENT_QML_PAGES_PREFIX)
    set(CLIENT_QML_PAGES_PREFIX "qrc:/ui/qml/Pages2/" CACHE STRING "PageController QML pages prefix")
endif()
if(NOT CLIENT_UI_FONT_RESOURCE)
    set(CLIENT_UI_FONT_RESOURCE ":/fonts/pt-root-ui_vf.ttf" CACHE STRING "UI font resource path")
endif()
if(NOT CLIENT_QML_QRC_FILE)
    set(CLIENT_QML_QRC_FILE "${_CLIENT_SRC_DIR}/ui/qml/qml.qrc" CACHE FILEPATH "QML resources manifest")
endif()
if(NOT CLIENT_EXTRA_QRC)
    set(CLIENT_EXTRA_QRC "" CACHE STRING "Optional semicolon-separated extra QRC files")
endif()

# -- translations
if(NOT CLIENT_TS_PREFIX)
    set(CLIENT_TS_PREFIX "vipn" CACHE STRING "Translation filename prefix")
endif()
if(NOT CLIENT_TS_FILES)
    set(CLIENT_TS_FILES "" CACHE STRING "Optional semicolon-separated absolute TS file paths")
endif()

# -- brand-provided headers
if(NOT CLIENT_BRANDING_INCLUDE_DIR)
    set(CLIENT_BRANDING_INCLUDE_DIR "" CACHE PATH "Optional include root for non-generated branding headers (e.g. pageEnum.h)")
endif()
if(CLIENT_BRANDING_INCLUDE_DIR AND EXISTS "${CLIENT_BRANDING_INCLUDE_DIR}/ui/utils/pageEnum.h")
    set(CLIENT_PAGE_ENUM_HEADER "${CLIENT_BRANDING_INCLUDE_DIR}/ui/utils/pageEnum.h")
else()
    set(CLIENT_PAGE_ENUM_HEADER "${_CLIENT_SRC_DIR}/ui/utils/pageEnum.h")
endif()

if(NOT CLIENT_NOTIFICATION_IDENTIFIER)
    set(CLIENT_NOTIFICATION_IDENTIFIER "${CLIENT_TS_PREFIX}" CACHE STRING "Local notification request identifier")
endif()

if(NOT DEFINED CLIENT_UPDATE_GITHUB_REPO)
    set(CLIENT_UPDATE_GITHUB_REPO "BeHuk-D/vipn-client")
endif()

if(NOT DEFINED CLIENT_ENABLE_APP_UPDATES)
    set(CLIENT_ENABLE_APP_UPDATES 1)
endif()
